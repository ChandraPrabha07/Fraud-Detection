# Copy to backend/.env and adjust as needed. All values are optional.
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex of extra allowed origins (default: any localhost port). Set empty in production.
# CORS_ORIGIN_REGEX=
# Override artefact locations (defaults are relative to the project root)
# FRAUD_PROJECT_ROOT=/opt/financial-fraud-ml
# MODELS_DIR=/opt/financial-fraud-ml/models
# RESULTS_DIR=/opt/financial-fraud-ml/results
# SYNTHETIC_DIR=/opt/financial-fraud-ml/data/synthetic
RECENT_PREDICTIONS_LIMIT=20
